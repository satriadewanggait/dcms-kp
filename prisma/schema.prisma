// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id
  name          String?
  email         String?     @unique
  image         String?
  role          String      @default("user")
  status        String      @default("pending")
  fileEntries   FileEntry[]
  sharedWith    SharedFile[] @relation("SharedFileWith")
  sharedBy      SharedFile[] @relation("SharedFileBy")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
}

model FileEntry {
  id           String   @id @default(cuid())
  name         String
  isFolder     Boolean  @default(false)
  fileLink     String   @default("")
  isStarred    Boolean  @default(false)
  isTrashed    Boolean  @default(false)
  folderId     String   @default("")
  publicId     String   @default("")
  resourceType String   @default("raw")
  fileSize     Int      @default(0)
  isShared     Boolean  @default(false)
  shareToken   String?  @unique
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerId, folderId, isFolder, name])
  @@index([ownerId, folderId])
  @@index([ownerId, isStarred])
  @@index([ownerId, isTrashed])
  @@index([publicId])
  sharedEntries SharedFile[] @relation("SharedFileEntry")
}

model SharedFile {
  id          String   @id @default(cuid())
  fileId      String
  file        FileEntry @relation("SharedFileEntry", fields: [fileId], references: [id], onDelete: Cascade)
  sharedWithId String
  sharedWith  User     @relation("SharedFileWith", fields: [sharedWithId], references: [id], onDelete: Cascade)
  sharedById  String
  sharedBy    User     @relation("SharedFileBy", fields: [sharedById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([fileId, sharedWithId])
  @@index([sharedWithId])
}
