// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id
  name          String?
  email         String?     @unique
  image         String?
  fileEntries   FileEntry[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
}

model FileEntry {
  id           String   @id @default(cuid())
  name         String
  isFolder     Boolean  @default(false)
  fileLink     String   @default("")
  isStarred    Boolean  @default(false)
  isTrashed    Boolean  @default(false)
  folderId     String   @default("")
  publicId     String   @default("")
  resourceType String   @default("raw")
  fileSize     Int      @default(0)
  isShared     Boolean  @default(false)
  shareToken   String?  @unique
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerId, folderId, isFolder, name])
  @@index([ownerId, folderId])
  @@index([ownerId, isStarred])
  @@index([ownerId, isTrashed])
  @@index([publicId])
}
